# AgriNexa Backend Configuration
# Copy this file to .env and fill in your actual values

# ─── SECRET & AUTH ───
SECRET_KEY=agrinexa-secret-key-2026-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=168

# ─── DATABASE ───
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=agrinexa

# ─── WEATHER API ───
# OpenWeatherMap (free tier: https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# IMD Weather API (Indian Meteorology Department - optional, complex setup)
IMD_API_KEY=your_imd_api_key_here

# ─── MARKET PRICE APIs ───
# AGMARKNET (https://agmarknet.gov.in) - Agricultural Market Information
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# e-NAM (e-National Agriculture Market) - Optional alternative
ENAM_API_KEY=your_enam_api_key_here

# ─── CACHING (Optional) ───
# Redis connection for caching market prices and weather (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# ─── PUSH NOTIFICATIONS ───
# Expo Push Notifications (for mobile alerts)
EXPO_ACCESS_TOKEN=your_expo_access_token_here

# ─── CORS & SECURITY ───
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── FILE STORAGE ───
# For storing uploaded crop photos (local or cloud)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── MODEL PATHS ───
# Pre-trained ML models directory
MODELS_DIR=./models/pretrained

# ─── RAG & LLM ───
# OpenAI key used by RAG retriever (optional: if missing, system falls back without LLM generation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI-compatible custom endpoint (LM Studio, vLLM, local gateway, etc.)
# Example cloud proxy: https://api.openai.com/v1
# Example local server: http://localhost:1234/v1
OPENAI_BASE_URL=

# OpenAI / compatible model name
# Example cloud model: gpt-4o-mini
# Example local model: llama-3.1-8b-instruct
OPENAI_MODEL=gpt-4o-mini

# RAG provider settings
RAG_VECTOR_DB_TYPE=chroma
RAG_LLM_PROVIDER=openai

# Optional Pinecone config (only if RAG_VECTOR_DB_TYPE=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_environment_here

# ─── LOGGING ───
LOG_LEVEL=INFO

# ─── DEPLOYMENT ───
ENVIRONMENT=development
DEBUG=True
